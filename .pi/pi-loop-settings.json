      "out": 6000
    },
    "piBinary": "pi",
    "registerBackgroundWorkProvider": true,
    "honorCapabilityCeiling": true,
    "criticalInterruptsAll": false,
    "showCostInStatusLine": true,
    "useLlmEvaluator": false,
    "envOverrides": {}
  }
}